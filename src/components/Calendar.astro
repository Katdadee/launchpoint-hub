---
import type { HubEvent } from '../lib/events';
import { longDate, timeRange, googleCalLink } from '../lib/events';
interface Props { events: HubEvent[] }
const { events } = Astro.props;
const payload = events.map((e) => ({
  id: e.id, title: e.title, date: e.date, type: e.type, when: timeRange(e), long: longDate(e.date),
  location: e.location ?? '', joinUrl: e.joinUrl, inPerson: e.inPerson, description: e.description ?? '', gcal: googleCalLink(e),
}));
const upcoming = events.slice(0, 8);
---
<section id="calendar" class="block">
  <div class="wrap">
    <div class="section-head">
      <div>
        <h2>Calendar</h2>
        <p class="muted">All times Central. Click any meeting for details and the Zoom button.</p>
      </div>
      <div class="btn-row no-print">
        <a class="btn btn-outline" href="/calendar.ics" title="Opens in Outlook, Apple Calendar or Google Calendar">📅 Subscribe / add all to my calendar</a>
      </div>
    </div>

    <div class="cal-layout">
      <div class="card cal-card">
        <div class="cal-nav">
          <button class="navbtn" id="cal-prev" aria-label="Previous month">‹</button>
          <h3 id="cal-label">Loading…</h3>
          <button class="navbtn" id="cal-next" aria-label="Next month">›</button>
          <button class="navbtn today" id="cal-today">Today</button>
        </div>
        <div class="cal-grid cal-head" aria-hidden="true">
          <span>Sun</span><span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span><span>Sat</span>
        </div>
        <div class="cal-grid" id="cal-days" role="grid"></div>
        <div class="legend small muted">
          <span><i class="dot meeting"></i>Group meeting</span>
          <span><i class="dot deadline"></i>Deadline</span>
          <span><i class="dot lc"></i>Leadership Clarksville</span>
          <span><i class="dot event"></i>Other</span>
        </div>
      </div>

      <aside class="card detail" id="cal-detail" aria-live="polite">
        <h3>Upcoming</h3>
        <ul class="plain" id="cal-upcoming">
          {upcoming.map((e) => (
            <li>
              <button class="evt-link" data-id={e.id}>
                <span class={`dot ${e.type}`}></span>
                <span><strong>{e.title}</strong><br /><span class="muted small">{longDate(e.date)} · {timeRange(e)}</span></span>
              </button>
            </li>
          ))}
          {upcoming.length === 0 && <li class="muted">Nothing scheduled yet.</li>}
        </ul>
      </aside>
    </div>
  </div>
</section>

<script type="application/json" id="cal-data" set:html={JSON.stringify(payload)}></script>
<script>
  type Ev = { id: string; title: string; date: string; type: string; when: string; long: string; location: string; joinUrl: string; inPerson: boolean; description: string; gcal: string };
  const events: Ev[] = JSON.parse(document.getElementById('cal-data')!.textContent || '[]');
  const byDate = new Map<string, Ev[]>();
  for (const e of events) byDate.set(e.date, [...(byDate.get(e.date) ?? []), e]);

  const now = new Date();
  const ymd = (d: Date) => `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
  const todayKey = ymd(now);
  // Start on the month of the next upcoming event (or this month).
  const nextEv = events.find((e) => e.date >= todayKey);
  let view = nextEv ? new Date(`${nextEv.date}T12:00:00`) : new Date(now);
  view.setDate(1);

  const grid = document.getElementById('cal-days')!;
  const label = document.getElementById('cal-label')!;
  const detail = document.getElementById('cal-detail')!;
  const upcomingHTML = detail.innerHTML;

  function render() {
    label.textContent = view.toLocaleDateString('en-US', { month: 'long', year: 'numeric' });
    grid.innerHTML = '';
    const first = new Date(view.getFullYear(), view.getMonth(), 1);
    const days = new Date(view.getFullYear(), view.getMonth() + 1, 0).getDate();
    for (let i = 0; i < first.getDay(); i++) grid.appendChild(cell('', 'pad'));
    for (let d = 1; d <= days; d++) {
      const key = ymd(new Date(view.getFullYear(), view.getMonth(), d));
      const evs = byDate.get(key) ?? [];
      const c = cell(String(d), evs.length ? 'has' : '');
      if (key === todayKey) c.classList.add('today');
      if (key < todayKey) c.classList.add('past');
      for (const e of evs) {
        const b = document.createElement('button');
        b.className = `chip ${e.type}`; b.textContent = e.title; b.title = e.title; b.dataset.id = e.id;
        c.appendChild(b);
      }
      grid.appendChild(c);
    }
  }
  function cell(text: string, cls: string) {
    const c = document.createElement('div');
    c.className = `day ${cls}`; c.setAttribute('role', 'gridcell');
    const n = document.createElement('span'); n.className = 'num'; n.textContent = text; c.appendChild(n);
    return c;
  }
  function show(id: string) {
    const e = events.find((x) => x.id === id); if (!e) return;
    const join = e.inPerson
      ? `<p class="muted"><strong>In person:</strong> ${esc(e.location)}</p>`
      : e.joinUrl
        ? `<a class="btn btn-primary" href="${e.joinUrl}" target="_blank" rel="noopener">Join Zoom Meeting</a>`
        : `<p class="muted small">Zoom link not set yet.</p>`;
    detail.innerHTML = `
      <button class="back" id="cal-back">‹ Back to upcoming</button>
      <span class="pill pill-navy">${labelFor(e.type)}</span>
      <h3>${esc(e.title)}</h3>
      <p><strong>${e.long}</strong><br>${e.when}</p>
      ${e.location && !e.inPerson ? `<p class="muted">${esc(e.location)}</p>` : ''}
      ${e.description ? `<p class="small">${esc(e.description)}</p>` : ''}
      <div class="btn-row">${join}<a class="btn btn-outline" href="${e.gcal}" target="_blank" rel="noopener">＋ Google Calendar</a></div>`;
    document.getElementById('cal-back')!.addEventListener('click', () => { detail.innerHTML = upcomingHTML; });
    detail.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }
  const labelFor = (t: string) => ({ meeting: 'Group meeting', deadline: 'Deadline', lc: 'Leadership Clarksville', event: 'Event' } as Record<string, string>)[t] ?? t;
  const esc = (s: string) => s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]!));

  document.getElementById('cal-prev')!.addEventListener('click', () => { view.setMonth(view.getMonth() - 1); render(); });
  document.getElementById('cal-next')!.addEventListener('click', () => { view.setMonth(view.getMonth() + 1); render(); });
  document.getElementById('cal-today')!.addEventListener('click', () => { view = new Date(now); view.setDate(1); render(); });
  document.getElementById('calendar')!.addEventListener('click', (ev) => {
    const t = (ev.target as HTMLElement).closest<HTMLElement>('[data-id]');
    if (t?.dataset.id) show(t.dataset.id);
  });
  render();
</script>

<style is:global>
#calendar .cal-layout { display: grid; grid-template-columns: 1.6fr 1fr; gap: 1.1rem; align-items: start; }
  #calendar .cal-nav { display: flex; align-items: center; gap: .5rem; margin-bottom: .75rem; }
  #calendar .cal-nav h3 { flex: 1; text-align: center; margin: 0; }
  #calendar .navbtn { border: 1px solid var(--line); background: #fff; border-radius: 8px; padding: .35rem .8rem; font-size: 1.1rem; cursor: pointer; color: var(--navy); }
  #calendar .navbtn.today { font-size: .9rem; font-weight: 700; }
  #calendar .navbtn:hover { background: #eef2f9; }
  #calendar .cal-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 4px; }
  #calendar .cal-head span { text-align: center; font-size: .8rem; font-weight: 700; color: var(--muted); padding-bottom: .25rem; text-transform: uppercase; }
  #calendar .day { min-width: 0; min-height: 84px; border: 1px solid var(--line); border-radius: 8px; padding: .3rem; background: #fff; display: flex; flex-direction: column; gap: 3px; }
  #calendar .day.pad { border-color: transparent; background: transparent; }
  #calendar .day.past { background: #fafafa; }
  #calendar .day.past .num { color: #9aa2b1; }
  #calendar .day.today { border-color: var(--green); box-shadow: inset 0 0 0 1px var(--green); }
  #calendar .day.today .num { background: var(--green); color: #fff; }
  #calendar .num { font-size: .85rem; font-weight: 700; width: 1.6rem; height: 1.6rem; display: grid; place-items: center; border-radius: 50%; color: var(--ink); }
  #calendar .chip { max-width: 100%; text-align: left; border: 0; cursor: pointer; font: inherit; font-size: .75rem; font-weight: 600; line-height: 1.2; padding: .25rem .4rem; border-radius: 6px; color: #fff; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  #calendar .chip.meeting, #calendar .dot.meeting { background: var(--green-deep); }
  #calendar .chip.deadline, #calendar .dot.deadline { background: var(--amber); }
  #calendar .chip.lc, #calendar .dot.lc { background: var(--navy); }
  #calendar .chip.event, #calendar .dot.event { background: #7a8496; }
  #calendar .chip:hover { filter: brightness(1.1); }
  #calendar .legend { display: flex; gap: 1rem; flex-wrap: wrap; margin-top: .75rem; }
  #calendar .dot { display: inline-block; width: .7rem; height: .7rem; border-radius: 50%; margin-right: .35rem; vertical-align: middle; flex: none; }
  #calendar .evt-link { display: flex; gap: .6rem; align-items: flex-start; width: 100%; text-align: left; border: 0; background: none; font: inherit; cursor: pointer; color: inherit; padding: .1rem 0; }
  #calendar .evt-link .dot { margin-top: .4rem; }
  #calendar .evt-link:hover strong { text-decoration: underline; color: var(--navy); }
  #calendar .back { border: 0; background: none; color: var(--navy); font: inherit; font-weight: 600; cursor: pointer; padding: 0; margin-bottom: .6rem; }
  #calendar .detail .btn { font-size: .95rem; padding: .7rem 1rem; }
  @media (max-width: 860px) {#calendar .cal-layout { grid-template-columns: 1fr; } #calendar .day { min-height: 64px; } #calendar .chip { font-size: 0; padding: 0; height: 6px; border-radius: 3px; } }
</style>
