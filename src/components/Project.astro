---
import { site, deliverables, phases, team } from '../config';
const done = deliverables.filter((d) => d.status === 'done').length;
const pct = Math.round((done / deliverables.length) * 100);
const today = new Date().toISOString().slice(0, 10);
const statusPill = { 'not-started': ['pill-gray', 'Not started'], 'in-progress': ['pill-amber', 'In progress'], done: ['pill-green', 'Done'] } as const;
const start = new Date(site.projectStart).getTime(), end = new Date(site.projectEnd).getTime();
const elapsed = Math.min(100, Math.max(0, Math.round(((Date.now() - start) / (end - start)) * 100)));
---
<section id="project" class="block">
  <div class="wrap">
    <div class="section-head">
      <div>
        <h2>The Project</h2>
        <p class="muted">{site.projectName}: {site.projectTagline}</p>
      </div>
    </div>

    <div class="grid cols-2" style="margin-bottom:1.1rem">
      <div class="card">
        <h3>What we've been asked to do</h3>
        <p>Develop a plan for a <strong>Youth Transition &amp; Independence Center</strong> serving young people ages 16–24 who are aging out of foster care, leaving juvenile-justice placements, experiencing homelessness, or entering adulthood without a stable family or support system.</p>
        <p>The center would be a <strong>coordinated point of access</strong> — housing assistance, employment &amp; career services, education support, behavioral health, transportation, financial literacy, life-skills training, legal help, and help obtaining ID, insurance and benefits — anchored by <strong>consistent relationships with trusted adult mentors</strong>.</p>
        <p class="small muted">Key question: should it be a physical location, a coordinated network of existing organizations, or a combination? The goal is the most practical, sustainable model for Clarksville-Montgomery County — not assuming a new organization is needed.</p>
        <details>
          <summary>Who we bring together</summary>
          <p class="small">Local government · schools · Austin Peay State University · employers · housing providers · Juvenile Court · Department of Children's Services · behavioral-health providers · nonprofits · faith-based groups · young adults with lived experience.</p>
        </details>
      </div>

      <div class="card">
        <div class="section-head" style="margin-bottom:.5rem">
          <h3 style="margin:0">Final plan — 9 deliverables</h3>
          <span class="pill pill-navy">{done} of {deliverables.length} done</span>
        </div>
        <div class="bar" aria-label={`${pct}% complete`}><span style={`width:${pct}%`}></span></div>
        <ul class="plain">
          {deliverables.map((d) => (
            <li class="deliv">
              <span class={`pill ${statusPill[d.status][0]}`}>{statusPill[d.status][1]}</span>
              <span><strong>{d.title}</strong>{d.owner && <span class="muted small"> · {d.owner}</span>}{d.note && <><br /><span class="muted small">{d.note}</span></>}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="card" style="margin-bottom:1.1rem">
      <div class="section-head" style="margin-bottom:.5rem">
        <h3 style="margin:0">9-month roadmap</h3>
        <span class="muted small">{site.projectStart.slice(0, 7)} → {site.projectEnd.slice(0, 7)} · {elapsed}% of the timeline elapsed</span>
      </div>
      <div class="bar thin"><span style={`width:${elapsed}%`}></span></div>
      <ol class="phases">
        {phases.map((p, i) => {
          const st = today < p.start ? 'upcoming' : today > p.end ? 'past' : 'current';
          return (
            <li class={st}>
              <div class="ph-head"><span class="num">{i + 1}</span><div><strong>{p.name}</strong><br /><span class="muted small">{p.months}{st === 'current' ? ' · now' : ''}</span></div></div>
              <ul class="small">{p.focus.map((f) => <li>{f}</li>)}</ul>
            </li>
          );
        })}
      </ol>
    </div>

    <div class="card" id="team">
      <h3>The team</h3>
      {team.length <= 1 && <p class="muted small">Roster coming soon — the hub admin will add everyone from <code>src/config.ts</code>.</p>}
      <ul class="plain team">
        {team.map((m) => (
          <li>
            <span class="avatar" aria-hidden="true">{m.name.split(' ').map((s) => s[0]).slice(0, 2).join('')}</span>
            <span><strong>{m.name}</strong><br /><span class="muted small">{[m.role, m.org].filter(Boolean).join(' · ')}</span>
              {(m.email || m.phone) && <><br /><span class="small">{m.email && <a href={`mailto:${m.email}`}>{m.email}</a>}{m.email && m.phone && ' · '}{m.phone && <a href={`tel:${m.phone}`}>{m.phone}</a>}</span></>}
            </span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
<style>
  .bar { height: 10px; border-radius: 999px; background: #e7eaf0; overflow: hidden; margin: .4rem 0 1rem; }
  .bar span { display: block; height: 100%; background: var(--green); border-radius: 999px; }
  .bar.thin { height: 6px; }
  .deliv { display: flex; gap: .8rem; align-items: flex-start; }
  .deliv .pill { flex: none; margin-top: .25rem; min-width: 6.4rem; text-align: center; }
  details summary { cursor: pointer; font-weight: 600; color: var(--navy); }
  .phases { list-style: none; padding: 0; margin: .5rem 0 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: .8rem; }
  .phases li { border: 1px solid var(--line); border-radius: 10px; padding: .8rem; background: #fff; }
  .phases li.current { border-color: var(--green); box-shadow: inset 0 0 0 1px var(--green); }
  .phases li.past { opacity: .7; }
  .ph-head { display: flex; gap: .6rem; align-items: flex-start; margin-bottom: .4rem; }
  .ph-head .num { flex: none; width: 1.7rem; height: 1.7rem; border-radius: 50%; background: var(--navy); color: #fff; display: grid; place-items: center; font-weight: 700; font-size: .85rem; }
  .phases li.current .num { background: var(--green-deep); }
  .phases ul { margin: 0; padding-left: 1.1rem; }
  .phases ul li { border: 0; padding: .15rem 0; background: none; opacity: 1; }
  .team { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: .4rem 1.5rem; }
  .team li { display: flex; gap: .7rem; align-items: center; border: 0; }
  .avatar { flex: none; width: 2.4rem; height: 2.4rem; border-radius: 50%; background: var(--green-soft); color: var(--green-deep); font-weight: 700; display: grid; place-items: center; font-size: .9rem; }
</style>
