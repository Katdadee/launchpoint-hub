---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
export async function getStaticPaths() {
  const notes = await getCollection('notes', ({ data }) => !data.draft);
  return notes.map((n) => ({ params: { slug: n.id }, props: { note: n } }));
}
const { note } = Astro.props;
const { Content } = await render(note);
const d = note.data;
const fmt = (x: Date, o: Intl.DateTimeFormatOptions = { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' }) => x.toLocaleDateString('en-US', { ...o, timeZone: 'UTC' });
const all = (await getCollection('notes', ({ data }) => !data.draft)).sort((a, b) => a.data.date.getTime() - b.data.date.getTime());
const i = all.findIndex((n) => n.id === note.id);
const prev = all[i - 1], next = all[i + 1];
---
<Base title={d.title} current="notes">
  <article class="block">
    <div class="wrap">
      <div class="section-head no-print">
        <a class="btn btn-outline" href="/notes">‹ All notes</a>
        <div class="btn-row">
          {prev && <a class="btn btn-outline" href={`/notes/${prev.id}`} title={prev.data.title}>‹ Previous</a>}
          {next && <a class="btn btn-outline" href={`/notes/${next.id}`} title={next.data.title}>Next ›</a>}
          <button class="btn btn-navy" onclick="window.print()">🖨 Print / Save as PDF</button>
        </div>
      </div>

      <header class="card head">
        <span class="pill pill-green">Meeting notes</span>
        <h1>{d.title}</h1>
        <p class="meta"><strong>{fmt(d.date)}</strong>{d.location && ` · ${d.location}`}</p>
        <dl class="facts">
          {d.facilitator && <><dt>Facilitator</dt><dd>{d.facilitator}</dd></>}
          {d.notetaker && <><dt>Notes by</dt><dd>{d.notetaker}</dd></>}
          {d.attendees.length > 0 && <><dt>Attending ({d.attendees.length})</dt><dd>{d.attendees.join(', ')}</dd></>}
          {d.nextMeeting && <><dt>Next meeting</dt><dd>{d.nextMeeting}</dd></>}
        </dl>
        {d.summary && <p class="summary">{d.summary}</p>}
      </header>

      <div class="grid cols-2" style="margin-top:1.1rem; align-items:start">
        {d.decisions.length > 0 && (
          <div class="card">
            <h3>✅ Decisions</h3>
            <ul class="tight">{d.decisions.map((x) => <li>{x}</li>)}</ul>
          </div>
        )}
        {d.actionItems.length > 0 && (
          <div class="card">
            <h3>📌 Action items</h3>
            <ul class="plain">
              {d.actionItems.map((a) => (
                <li class="ai">
                  <span class={`box ${a.done ? 'done' : ''}`} aria-hidden="true">{a.done ? '✓' : ''}</span>
                  <span><span class={a.done ? 'strike' : ''}>{a.task}</span><br /><span class="muted small">{a.owner}{a.due && ` · due ${fmt(a.due, { month: 'short', day: 'numeric' })}`}</span></span>
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>

      <div class="card prose" style="margin-top:1.1rem">
        <Content />
      </div>
    </div>
  </article>
</Base>
<style>
  .head { border-top: 6px solid var(--green); }
  .head h1 { margin-top: .5rem; }
  .meta { font-size: 1.1rem; margin-bottom: .75rem; }
  .facts { display: grid; grid-template-columns: max-content 1fr; gap: .25rem 1rem; margin: 0 0 .75rem; font-size: .95rem; }
  .facts dt { color: var(--muted); font-weight: 600; }
  .facts dd { margin: 0; }
  .summary { font-size: 1.05rem; border-left: 4px solid var(--green); padding-left: .9rem; margin: 0; }
  .tight { margin: 0; padding-left: 1.2rem; }
  .tight li { padding: .25rem 0; }
  .ai { display: flex; gap: .7rem; align-items: flex-start; }
  .box { flex: none; width: 1.35rem; height: 1.35rem; border: 2px solid var(--navy); border-radius: 5px; display: grid; place-items: center; font-size: .85rem; margin-top: .15rem; }
  .box.done { background: var(--green); border-color: var(--green); color: #fff; }
  .strike { text-decoration: line-through; color: var(--muted); }
</style>
