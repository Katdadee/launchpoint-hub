---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found">
  <section class="block">
    <div class="wrap">
      <div class="card" style="text-align:center; padding:2.5rem 1.5rem">
        <h1>We couldn't find that page</h1>
        <p class="muted">The link may be old or mistyped. Everything the group needs is on the home page.</p>
        <p><a class="btn btn-primary" href="/">Go to the hub home page</a></p>
      </div>
    </div>
  </section>
</Base>
